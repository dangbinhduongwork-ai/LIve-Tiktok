# Server Configuration
PORT=3000
# Server is always bound to 127.0.0.1 for local OBS/admin use.

# Optional: fixed admin token. If empty, generated in data/admin-token.txt.
ADMIN_TOKEN=

# Optional additional browser origins, comma-separated (for a separate game dev server).
ALLOWED_ORIGINS=

# TikTok Sign Server API Key (Tùy chọn: Nhận API Key miễn phí tại https://www.eulerstream.com để không bị giới hạn số lần kết nối)
SIGN_API_KEY=

